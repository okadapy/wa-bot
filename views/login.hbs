<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>
      Авторизация
    </title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="login-page">
    <div class="login-container">
      <h2 class="card login-h2-card">
        Авторизация
      </h2>
      <form action="/login" method="POST">
        <div class="form-group">
          <label for="phone">
            Номер телефона:
          </label>
          <input type="text" id="phone" name="phone" required placeholder="79991234567" />
        </div>
        <div class="form-group">
          <label for="password">
            Пароль:
          </label>
          <input type="password" id="password" name="password" required />
        </div>
        {{#if error}}
          <p class="error-message">
            {{error}}
          </p>
        {{/if}}
        <button type="submit" class="btn btn-login">
          Войти
        </button>
      </form>
      <div class="btn-support-login_wrap">
        <a
          href="https://wa.me/79892270667?text=Здравствуйте, нужна помощь!"
          class="btn btn-support btn-support-login"
          target="_blank"
          rel="noopener noreferrer"
        >
          [ Поддержка ]
        </a>
      </div>
    </div>
  </body>
</html>